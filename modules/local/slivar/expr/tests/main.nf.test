nextflow_process {

    name "Test Process SLIVAR_EXPR"
    script "../main.nf"
    process "SLIVAR_EXPR"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "slivar"
    tag "slivar/expr"

    test("expr_vcf") {
        when {
            params {
                args_modules = "--info 'variant.FILTER == \"PASS\" && variant.ALT[0] != \"*\"'"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/test.vcf", checkIfExists: true),
                    [],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/testa.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.vcf.get(0).get(1)).linesGzip.contains("##fileformat=VCFv4.1") },
                { assert snapshot(process.out.summary, process.out.versions).match() }
            )
        }
    }

    test("js_expr_vcf") {
        when {
            params {
                args_modules = "--trio 'good_qual_trio:hq(kid, mom, dad)' --family-expr 'good_qual_fam:fam.every(hq1)'"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/test.vcf", checkIfExists: true),
                    [],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/testa.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = file("${moduleTestDir}/test-functions.js", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.vcf.get(0).get(1)).linesGzip.contains("##fileformat=VCFv4.1") },
                { assert snapshot(process.out.summary, process.out.versions).match() }
            )
        }
    }

    test("parental_origin-po_validation") {
        // Reproduces the po_* and proband-genotype --trio expressions from
        // conf/slivar.config verbatim (the AF-gate clauses there are empty unless
        // slivar_gnomad_gnotate/slivar_topmed_gnotate are set, which they aren't
        // here) against the real assets/slivar-functions.js and a fixture VCF that
        // was hand-built to hit all 9 possible parental_origin() return labels,
        // plus hom-ref and unknown probands, which get no po_* tag -- see
        // subworkflows/local/slivar_inheritance/tests/fixtures/. The fixture carries
        // no slivar tags of its own: slivar never removes an INFO tag already in
        // its input, so a stale one would satisfy these assertions by itself.
        when {
            params {
                args_modules = [
                    "--info 'variant.FILTER == \"PASS\" && variant.ALT[0] != \"*\" && INFO.impactful'",
                    "--trio 'non_carrier_proband:proband_non_carrier(kid)'",
                    "--trio 'unknown_proband_genotype:proband_gt_unknown(kid)'",
                    "--trio \"po_denovo:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'DENOVO'\"",
                    "--trio \"po_mother:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'MOTHER'\"",
                    "--trio \"po_father:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'FATHER'\"",
                    "--trio \"po_both:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'BOTH'\"",
                    "--trio \"po_ambiguous:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'AMBIGUOUS'\"",
                    "--trio \"po_possible_denovo:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_DENOVO'\"",
                    "--trio \"po_possible_mother:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_MOTHER'\"",
                    "--trio \"po_possible_father:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_FATHER'\"",
                    "--trio \"po_unknown:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'UNKNOWN'\""
                ].join(" ")
            }
            process {
                """
                input[0] = [
                    [ id:'po_validation' ],
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/po_validation.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/po_validation.vcf.gz.tbi", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/po_validation.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = file("\${projectDir}/assets/slivar-functions.js", checkIfExists: true)
                """
            }
        }

        then {
            def lines = path(process.out.vcf.get(0).get(1)).linesGzip.findAll { !it.startsWith('#') }
            def anyPoTag = ~/;po_\w+=/

            assertAll(
                { assert process.success },
                { assert lines.size() == 20 },
                { assert lines.find { it.startsWith("chr1\t1000\t") }.contains("po_denovo=kid") },
                { assert lines.find { it.startsWith("chr1\t2000\t") }.contains("po_mother=kid") },
                { assert lines.find { it.startsWith("chr1\t3000\t") }.contains("po_father=kid") },
                { assert lines.find { it.startsWith("chr1\t4000\t") }.contains("po_both=kid") },
                { assert lines.find { it.startsWith("chr1\t5000\t") }.contains("po_ambiguous=kid") },
                { assert lines.find { it.startsWith("chr1\t6000\t") }.contains("po_possible_denovo=kid") },
                { assert lines.find { it.startsWith("chr1\t7000\t") }.contains("po_possible_mother=kid") },
                { assert lines.find { it.startsWith("chr1\t8000\t") }.contains("po_unknown=kid") },
                { assert lines.find { it.startsWith("chr1\t9000\t") }.contains("po_possible_denovo=kid") },
                { assert lines.find { it.startsWith("chr1\t10000\t") }.contains("po_possible_denovo=kid") },
                { assert lines.find { it.startsWith("chr1\t13000\t") }.contains("po_father=kid") },
                { assert lines.find { it.startsWith("chrX\t3000000\t") }.contains("po_mother=kid") },
                { assert lines.find { it.startsWith("chrX\t3100000\t") }.contains("po_father=kid") },
                { assert lines.find { it.startsWith("chrY\t3000000\t") }.contains("po_father=kid") },
                // Unknown proband: het with 1 alt read (11000), no-call (12000), and
                // hom-ref with 2 ref reads (15000) -- po_adj() downgrades all three.
                { assert lines.find { it.startsWith("chr1\t11000\t") }.contains("unknown_proband_genotype=kid") },
                { assert !(lines.find { it.startsWith("chr1\t11000\t") } =~ anyPoTag) },
                { assert lines.find { it.startsWith("chr1\t12000\t") }.contains("unknown_proband_genotype=kid") },
                { assert !(lines.find { it.startsWith("chr1\t12000\t") } =~ anyPoTag) },
                { assert lines.find { it.startsWith("chr1\t15000\t") }.contains("unknown_proband_genotype=kid") },
                { assert !(lines.find { it.startsWith("chr1\t15000\t") } =~ anyPoTag) },
                // Hom-ref proband. On X and Y the son tables are keyed on the parents
                // only, so without the guard these would be po_mother / po_father.
                { assert lines.find { it.startsWith("chr1\t14000\t") }.contains("non_carrier_proband=kid") },
                { assert !(lines.find { it.startsWith("chr1\t14000\t") } =~ anyPoTag) },
                { assert lines.find { it.startsWith("chrX\t3200000\t") }.contains("non_carrier_proband=kid") },
                { assert !(lines.find { it.startsWith("chrX\t3200000\t") } =~ anyPoTag) },
                { assert lines.find { it.startsWith("chrY\t3100000\t") }.contains("non_carrier_proband=kid") },
                { assert !(lines.find { it.startsWith("chrY\t3100000\t") } =~ anyPoTag) },
                // A carrier proband never gets a proband-genotype tag.
                { assert lines.findAll { it.contains("non_carrier_proband=") }.size() == 3 },
                { assert lines.findAll { it.contains("unknown_proband_genotype=") }.size() == 3 }
            )
        }
    }

    test("parental_origin-trio_gating") {
        // Guards the concern behind BIOINFO-217's parental-origin step: the po_*
        // --trio expressions must only ever be evaluated for genuinely complete
        // trios. This fixture packs a real trio alongside a solo sample, a duo
        // with an unknown father, a duo with an unknown mother, a sibship, and a
        // family whose PED declares a third member that simply isn't in the VCF --
        // all sharing one variant record. Only the real trio's kid may end up with
        // a po_* tag.
        when {
            params {
                args_modules = [
                    "--info 'variant.FILTER == \"PASS\" && variant.ALT[0] != \"*\" && INFO.impactful'",
                    "--trio 'comphet_side:comphet_side(kid, mom, dad)'",
                    "--family-expr 'het_side:moi_het_side(fam)'",
                    "--trio \"po_denovo:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'DENOVO'\"",
                    "--trio \"po_mother:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'MOTHER'\"",
                    "--trio \"po_father:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'FATHER'\"",
                    "--trio \"po_both:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'BOTH'\"",
                    "--trio \"po_ambiguous:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'AMBIGUOUS'\"",
                    "--trio \"po_possible_denovo:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_DENOVO'\"",
                    "--trio \"po_possible_mother:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_MOTHER'\"",
                    "--trio \"po_possible_father:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_FATHER'\"",
                    "--trio \"po_unknown:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'UNKNOWN'\""
                ].join(" ")
            }
            process {
                """
                input[0] = [
                    [ id:'trio_gating' ],
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.vcf.gz.tbi", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = file("\${projectDir}/assets/slivar-functions.js", checkIfExists: true)
                """
            }
        }

        then {
            def line = path(process.out.vcf.get(0).get(1)).linesGzip.find { !it.startsWith('#') }

            assertAll(
                { assert process.success },
                { assert line.contains("po_denovo=kid") },
                { assert !line.contains("po_mother=") },
                { assert !line.contains("po_father=") },
                { assert !line.contains("po_both=") },
                { assert !line.contains("po_ambiguous=") },
                { assert !line.contains("po_possible_denovo=") },
                { assert !line.contains("po_possible_mother=") },
                { assert !line.contains("po_possible_father=") },
                { assert !line.contains("po_unknown=") },
                // belt-and-suspenders: no po_* tag ever names a non-trio family member
                { assert !(line =~ /po_\w+=[^;]*\b(solo1|duokid|duomom|kid2|mom2|duokid2|duodad|sib1|sib2)\b/) }
            )
        }
    }

    test("transmission_sentinels-trio_gating") {
        // Reproduces the unknown_*_genotype / proband-genotype expressions from
        // conf/slivar.config against the same mixed-structure fixture. The tag
        // value lists the family's affected sample(s). kid2's PED names a father
        // who isn't in the VCF; slivar then drops BOTH of kid2's parent links, so
        // this guards the parents-by-sex lookup that still finds mom2.
        when {
            params {
                args_modules = [
                    "--info 'variant.FILTER == \"PASS\" && variant.ALT[0] != \"*\" && INFO.impactful'",
                    "--family-expr 'unknown_parents_genotype:moi_unknown_parents_genotype(fam)'",
                    "--family-expr 'unknown_father_genotype:moi_unknown_father_genotype(fam)'",
                    "--family-expr 'unknown_mother_genotype:moi_unknown_mother_genotype(fam)'",
                    "--trio 'non_carrier_proband:proband_non_carrier(kid)'",
                    "--trio 'unknown_proband_genotype:proband_gt_unknown(kid)'"
                ].join(" ")
            }
            process {
                """
                input[0] = [
                    [ id:'trio_gating' ],
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.vcf.gz.tbi", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = file("\${projectDir}/assets/slivar-functions.js", checkIfExists: true)
                """
            }
        }

        then {
            def line = path(process.out.vcf.get(0).get(1)).linesGzip.find { !it.startsWith('#') }
            // INFO tag -> set of sample IDs (slivar's sample order within a tag isn't guaranteed)
            def tags = line.split('\t')[7].split(';').findAll { it.contains('=') }.collectEntries { field ->
                def (key, value) = field.split('=', 2)
                [ (key): value.split(',') as Set ]
            }

            assertAll(
                { assert process.success },
                { assert tags.unknown_parents_genotype == ['solo1', 'sib1'] as Set },
                { assert tags.unknown_father_genotype == ['duokid', 'kid2'] as Set },
                { assert tags.unknown_mother_genotype == ['duokid2'] as Set },
                // the only complete trio's kid is het
                { assert !tags.containsKey('non_carrier_proband') },
                { assert !tags.containsKey('unknown_proband_genotype') }
            )
        }
    }

    test("expr_vcf-stub") {

        options "-stub"

        when {
            params {
                args_modules = "--info 'variant.FILTER == \"PASS\""
            }
            process {
                """
                input[0] = [
                    [ id:'test_stub' ],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/test.vcf", checkIfExists: true),
                    [],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/testa.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
