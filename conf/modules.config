/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

def default_publish_dir = [
    path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
    mode: params.publish_dir_mode,
    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
]

process {

    publishDir = params.publish_all? default_publish_dir : []

    withName: BCFTOOLS_VIEW {
        container = 'staphb/bcftools:1.20'
        ext.args = { '-Oz --write-index=tbi' }
        ext.prefix = {meta.id + ".standardized.g"}
    }

    withName: BCFTOOLS_FILTER {
        container = 'staphb/bcftools:1.20'
        // Keep only records that carry the <NON_REF> allele required of any valid gVCF
        // record. DRAGEN 4.4.7 gVCFs have been observed with ~0.005% of records missing
        // it, which makes GATK4_GENOTYPEGVCFS fail outright ("the list of input alleles
        // must contain <NON_REF>") -- BIOINFO-222. This replaces a previous MNP-exclusion
        // expression (`strlen(REF)>1 & strlen(REF)==strlen(ALT) & TYPE="snp"`) that could
        // never match anything: bcftools classifies any same-length, >1bp substitution as
        // TYPE="mnp", never TYPE="snp", so that condition was unsatisfiable for any input,
        // from any caller -- confirmed empirically, and independently by this pipeline's
        // own past documentation ("despite the name, no true MNPs will be removed").
        ext.args = {'-i \'ALT~"NON_REF"\' -Oz --write-index=tbi'}
        ext.prefix = {meta.id + ".filtered"}
    }

    withName: BCFTOOLS_NORM {
        container = 'staphb/bcftools:1.20'
        ext.args = {'-c w -d all -Oz --write-index=tbi'}
        ext.prefix = {meta.id + ".normalized"}
    }

    withName: COMBINEGVCFS {
        container = 'broadinstitute/gatk:4.5.0.0'
    }

    withName: GATK4_GENOTYPEGVCFS {
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.args = params.allow_old_gatk_data ? "--allow-old-rms-mapping-quality-annotation-data" : ""
        ext.prefix = {meta.id + ".genotyped"}
    }

    withName: GATK4_VARIANTFILTRATION {
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.prefix = {meta.id + ".hardfiltered"}
        //collects all filters given as parameter, separating by name and expression
        ext.args = { params.hardFilters.collect{ f -> "--filter \"${f.expression}\" --filter-name \"${f.name}\"" }.join(" ") }
    }

    withName: GATK4_VARIANTRECALIBRATOR_SNP {
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.prefix = { "${meta.id}.snp.vqsr" }
        ext.args   = [ "${params.vqsr_snp_tranches.collect{ t -> "-tranche $t" }.join(' ')}",
                    "${params.vqsr_snp_annotations.collect{ a -> "-an $a" }.join(' ')}",
                    "--trust-all-polymorphic",
                    "--max-gaussians 6",
                    "--mode SNP" ]
                    .join(" ")
    }

    withName: GATK4_VARIANTRECALIBRATOR_INDEL {
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.prefix = { "${meta.id}.indel.vqsr" }
        ext.args   = [ "${params.vqsr_indel_tranches.collect{ t -> "-tranche $t" }.join(' ')}",
                    "${params.vqsr_indel_annotations.collect{ a -> "-an $a" }.join(' ')}",
                    "--trust-all-polymorphic",
                    "--max-gaussians 4",
                    "--mode INDEL" ]
                    .join(" ")
    }

    withName: GATK4_APPLYVQSR_SNP {
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.prefix = { "${meta.id}.snp.vqsr_${params.TSfilterSNP}" }
        ext.args = { "--mode SNP --truth-sensitivity-filter-level ${params.TSfilterSNP}" }
    }

    withName: GATK4_APPLYVQSR_INDEL {
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.prefix = { "${meta.id}.snpindel.vqsr_${params.TSfilterINDEL}" }
        ext.args = { "--mode INDEL --truth-sensitivity-filter-level ${params.TSfilterINDEL}" }
    }

    withName: EXOMISER {
        container = 'exomiser/exomiser-cli:14.0.0-bash'
        publishDir = [
            path: { params.exomiser_outdir ?: "${params.outdir}/exomiser" },
            pattern: '*{vcf.gz,vcf.gz.tbi,tsv,json,html}',
            mode: params.publish_dir_mode,
        ]
        ext.args = { "--output-filename=${meta.id}.exomiser" }
    }

    withName: ENSEMBLVEP_DOWNLOAD {
        // Using the conda container as the official one from esemblorg does not have the download_vep function used in nf-core.
        container = 'quay.io/biocontainers/ensembl-vep:114.2--pl5321h2a3209d_1'
        ext.when  = { params.tools && (params.tools.split(',').contains('vep')) }
        ext.args  = '--AUTO c --CONVERT --NO_BIOPERL --NO_HTSLIB --NO_TEST --NO_UPDATE'
        ext.prefix  = { "${params.vep_cache_version}_${params.vep_genome}" }
        publishDir  = [
            mode: params.publish_dir_mode,
            path: { params.outdir_cache ? "${params.outdir_cache}/": "${params.outdir}/cache/" }
        ]
    }

    withName: ENSEMBLVEP_VEP {
        container = 'ensemblorg/ensembl-vep:release_114.2'
        // The merged Ensembl/RefSeq cache (params.vep_annotation == 'merged') requires the
        // --merged flag, exposes MANE annotations via --mane, and adds extra fields (MANE,
        // MANE_SELECT, REFSEQ_MATCH, BAM_EDIT, SOURCE) not present in the plain Ensembl cache.
        // The RefSeq-only cache (params.vep_annotation == 'refseq') requires --refseq so VEP
        // resolves the <vep_species>_refseq cache subdirectory. --species itself always stays
        // the plain species name (see vep_species in snv_post_processing.nf) -- VEP rejects a
        // "_merged"/"_refseq" suffix there. See BIOINFO-220.
        def is_merged_cache = params.vep_annotation == 'merged'
        def is_refseq_cache = params.vep_annotation == 'refseq'
        def args_list =  [
            "--offline",
            "--format vcf",
            "--vcf",
            "--xref_refseq",
            "--variant_class",
            "--numbers",
            "--hgvs",
            "--hgvsg",
            "--canonical",
            "--symbol",
            "--flag_pick",
            "--no_stats"
        ]
        // Without --pick_order, VEP picks by its own order, where consequence
        // severity (rank) only comes 8th: a variant missense in one gene and downstream
        // of another could be picked as downstream. See vep_pick_order (RAD-216).
        if (params.vep_pick_order) {
            args_list += ["--pick_order ${params.vep_pick_order}"]
        }
        if (is_merged_cache) {
            args_list += ["--mane", "--merged"]
        } else if (is_refseq_cache) {
            args_list += ["--refseq"]
        }
        def fields = is_merged_cache
            ? "Allele,Consequence,IMPACT,SYMBOL,Feature_type,Gene,PICK,Feature,EXON,BIOTYPE,INTRON,HGVSc,HGVSp,STRAND,CDS_position,cDNA_position,Protein_position,Amino_acids,Codons,VARIANT_CLASS,HGVSg,CANONICAL,MANE,MANE_SELECT,RefSeq,REFSEQ_MATCH,BAM_EDIT,SOURCE"
            : "Allele,Consequence,IMPACT,SYMBOL,Feature_type,Gene,PICK,Feature,EXON,BIOTYPE,INTRON,HGVSc,HGVSp,STRAND,CDS_position,cDNA_position,Protein_position,Amino_acids,Codons,VARIANT_CLASS,HGVSg,CANONICAL,RefSeq"
        args_list += ["--fields \"${fields}\""]
        ext.args = args_list.join(" ")
        ext.prefix =  {"variants.${meta.id}.snv.vep"}
    }

    withName: '.*VCF_ANNOTATE_ENSEMBLVEP.*' {
        publishDir = [
            path: { params.vep_outdir ?: "${params.outdir}/ensemblvep" },
            mode: params.publish_dir_mode,
            pattern: '*{vcf.gz,vcf.gz.tbi}'
        ]
    }

    // SLIVAR_EXPR, SLIVAR_COMPOUNDHETS, and BCFTOOLS_ANNOTATE (used by the slivar
    // inheritance subworkflow) are configured in conf/slivar.config -- included
    // from nextflow.config after this file.

    withName: SPLIT_MULTIALLELICS {
        container = 'staphb/bcftools:1.20'
        ext.prefix = { "${meta.id}.splitted" }
        // Purely an intermediate now -- BCFTOOLS_PLUGINFIXPLOIDY (below) is the
        // last step before the VEP/exomiser fork, so it owns the
        // "normalized_genotypes" publish + manifest naming instead.
    }

    withName: BCFTOOLS_PLUGINFIXPLOIDY {
        // Moved off the module default (community.wave.seqera.io), which is firewalled in
        // some deployment environments (e.g. our AWS setup), to quay.io/biocontainers --
        // already reachable there (see ENSEMBLVEP_DOWNLOAD above) and hosting the identical
        // bcftools 1.23.1 build. Deliberately NOT staphb/bcftools:1.20 (used elsewhere in
        // this pipeline) -- see the phased "|" vs unphased "/" GT-separator difference
        // documented in tests/bcftools_pluginfixploidy/main.nf.test; keeping the exact
        // version this behavior was validated against avoids reintroducing that risk.
        container = 'quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
        // Deliberately distinct from SPLIT_MULTIALLELICS's "${meta.id}.splitted"
        // prefix: this process takes that file as input, staged into its own
        // work dir under that same name -- reusing the identical prefix for
        // this step's own output would collide with its own staged input
        // (same filename, same directory), which bcftools would have to read
        // from and write to simultaneously, and which Nextflow refuses to
        // recognize as a genuine new output for the same reason.
        ext.prefix = { "${meta.id}.normalized" }
        ext.args   = { '-Oz --write-index=tbi' }
        // Force diploid GT notation regardless of caller convention -- see
        // BIOINFO-217. No ploidy/sex file needed: -f 2 blindly expands any
        // haploid GT (DRAGEN-style, e.g. male non-PAR X/Y) to its diploid
        // equivalent (1 -> 1/1, 0 -> 0/0); already-diploid GTs (GATK4-style)
        // are left untouched.
        ext.args2  = { '-f 2' }
        publishDir = [
            enabled: params.save_genotyped || !params.tools,
            path: { "${params.outdir}/normalized_genotypes" },
            mode: params.publish_dir_mode,
            pattern: '*{normalized.vcf.gz,normalized.vcf.gz.tbi}'
        ]
    }
}
