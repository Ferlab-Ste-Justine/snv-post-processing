/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Slivar inheritance / segregation expressions
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process options for the SLIVAR_INHERITANCE subworkflow:
        - SLIVAR_EXPR         : runs `slivar expr` with the moi_*(fam) tag functions
                                from assets/slivar-functions.js. The list below is
                                just `tag : moi_function(fam) <AF clause>` -- the
                                actual logic lives in the JS file.
        - SLIVAR_COMPOUNDHETS : pairs comphet_side / het_side / denovo_side
                                variants (impactful only) within genes.
        - BCFTOOLS_ANNOTATE   : folds the compound-hets annotation onto the
                                expr output and strips the intermediate side fields.

    Loaded from nextflow.config after conf/modules.config so the slivar process
    options replace any earlier defaults.
----------------------------------------------------------------------------------------
*/

process {

    withName: SLIVAR_EXPR {
        publishDir = [
            path: { "${params.outdir}/slivar" },
            pattern: '*.slivar.summary.txt',
            mode: params.publish_dir_mode,
        ]
        ext.prefix = { "variants.${meta.id}.snv.vep.expr" }

        // Local `def` declarations must sit inside a closure scope (the Nextflow
        // language server rejects them at the withName level), so the whole
        // expression list is built lazily inside the ext.args closure.
        ext.args = {
            // AF-threshold clauses built from Nextflow params (empty when the
            // param is unset, so the appended clause is a no-op).
            def afRare      = params.slivar_gnomad_gnotate && params.gnomad_popmax_af_rare      ? "&& INFO.gnomad_popmax_af < ${params.gnomad_popmax_af_rare}"      : ''
            def afTopmed    = params.slivar_topmed_gnotate && params.topmed_af_rare             ? "&& INFO.topmed_af < ${params.topmed_af_rare}"                    : ''
            def afDominant  = params.slivar_gnomad_gnotate && params.gnomad_popmax_af_dominant  ? "&& INFO.gnomad_popmax_af < ${params.gnomad_popmax_af_dominant}"  : ''
            def afRecessive = params.slivar_gnomad_gnotate && params.gnomad_popmax_af_recessive ? "&& INFO.gnomad_popmax_af < ${params.gnomad_popmax_af_recessive}" : ''
            def afNhomalt   = params.slivar_gnomad_gnotate && params.gnomad_nhomalt             ? "&& INFO.gnomad_nhomalt < ${params.gnomad_nhomalt}"               : ''

            // Each row maps a tag name to a moi_*(fam) function defined in
            // assets/slivar-functions.js. The AF clause is the only runtime
            // variable; the actual MoI logic lives in the JS file.
            [
                // Pre-filter applied to every variant before any other expression is evaluated.
                // No INFO.impactful here: inheritance and parental-origin tags are set on every
                // PASS variant, as the Radiant ETL does. INFO.impactful gates only the
                // compound-het sides below.
                "--info 'variant.FILTER == \"PASS\" && variant.ALT[0] != \"*\" ${afRare} ${afTopmed}'",

                // MoI tags are named after Radiant's transmission_mode values
                // (uniparental_disomy has no Radiant equivalent and keeps its name).

                // Autosomal MoIs. De novo self-gates to trios via segregating_denovo;
                // dominant requires an affected parent (else it would fire on de novos);
                // upd requires a complete trio with exactly one parent hom_ref.
                "--family-expr 'autosomal_dominant_denovo:moi_denovo(fam) ${afDominant}'",
                "--family-expr 'autosomal_recessive:moi_recessive(fam) ${afRecessive}'",
                "--family-expr 'autosomal_dominant:moi_dominant(fam) ${afDominant}'",
                "--family-expr 'uniparental_disomy:moi_upd(fam) ${afRecessive}'",

                // X-linked MoIs. An X de novo is named by the child's sex: daughter ->
                // dominant, son (hemizygous) -> recessive.
                "--family-expr 'x_linked_dominant_denovo:moi_x_denovo_female(fam) ${afDominant}'",
                "--family-expr 'x_linked_recessive_denovo:moi_x_denovo_male(fam) ${afDominant}'",
                "--family-expr 'x_linked_recessive:moi_x_recessive(fam) ${afRecessive}'",
                "--family-expr 'x_linked_dominant:moi_x_dominant(fam) ${afDominant}'",

                // Compound-het sides, read by SLIVAR_COMPOUNDHETS and stripped by
                // BCFTOOLS_ANNOTATE below. Only impactful variants can be a side:
                // compound-hets' own --skip list drops intronic/UTR/intergenic
                // consequences but not synonymous ones.
                //   trios:     transmission-aware comphet_side(kid, mom, dad) via --trio
                //   non-trios: moi_het_side(fam) -- any hq het in an affected member,
                //              dropped if any unaffected parent is hom_alt
                //   de novos:  denovo_side, the impactful subset of autosomal_dominant_denovo,
                //              so a de novo can pair with an inherited het in the same gene
                "--trio 'comphet_side:comphet_side(kid, mom, dad) && INFO.impactful ${afNhomalt}'",
                "--family-expr 'het_side:moi_het_side(fam) && INFO.impactful ${afNhomalt}'",
                "--family-expr 'denovo_side:moi_denovo(fam) && INFO.impactful ${afDominant}'",

                // Set alongside an MoI tag when family structure can't prove segregation
                // (autosomal_recessive in non-trio, x_linked_recessive without informative
                // structure). Downstream lower-confidence flag.
                "--family-expr 'candidate:moi_candidate(fam)'",

                // Why no transmission mode can be assigned (Radiant's values, verbatim).
                // Missing parents are family-level; the proband checks run per kid and
                // only in complete trios, because a missing parent takes precedence.
                "--family-expr 'unknown_parents_genotype:moi_unknown_parents_genotype(fam)'",
                "--family-expr 'unknown_father_genotype:moi_unknown_father_genotype(fam)'",
                "--family-expr 'unknown_mother_genotype:moi_unknown_mother_genotype(fam)'",
                "--trio 'non_carrier_proband:proband_non_carrier(kid)'",
                "--trio 'unknown_proband_genotype:proband_gt_unknown(kid)'",

                // Parental origin, per sample: any child with at least one parent in the family
                // (trios and duos; a missing parent counts as unknown, as in Radiant). A hom-ref
                // or unknown child gets no po_* tag (non_carrier_proband / unknown_proband_genotype
                // or the family's unknown_*_genotype tag say why).
                "--sample-expr \"po_denovo:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'DENOVO'\"",
                "--sample-expr \"po_mother:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'MOTHER'\"",
                "--sample-expr \"po_father:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'FATHER'\"",
                "--sample-expr \"po_both:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'BOTH'\"",
                "--sample-expr \"po_ambiguous:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'AMBIGUOUS'\"",
                "--sample-expr \"po_possible_denovo:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'POSSIBLE_DENOVO'\"",
                "--sample-expr \"po_possible_mother:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'POSSIBLE_MOTHER'\"",
                "--sample-expr \"po_possible_father:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'POSSIBLE_FATHER'\"",
                "--sample-expr \"po_unknown:sample_parental_origin(variant.CHROM, variant.POS, sample) == 'UNKNOWN'\""
            ].join(" ")
        }
    }

    withName: SLIVAR_COMPOUNDHETS {
        publishDir = [
            path: { "${params.outdir}/slivar" },
            pattern: '*.slivar.summary.txt',
            mode: params.publish_dir_mode,
        ]

        // sample-fields consumed here (all impactful-only, see SLIVAR_EXPR above):
        //   comphet_side  -- populated by `--trio comphet_side` for trios (transmission-aware)
        //   het_side      -- populated by the duo/solo family-expr above (any hq het in proband)
        //   denovo_side   -- so a de novo variant can pair with an inherited het in the same gene
        // slivar silently ignores a --sample-field that doesn't exist, so keep these
        // names in sync with SLIVAR_EXPR.
        ext.args = { "--allow-non-trios --sample-field comphet_side --sample-field denovo_side --sample-field het_side" }
        ext.prefix = { "variants.${meta.id}.snv.vep.ch" }
    }

    withName: BCFTOOLS_ANNOTATE {
        // Overrides the module default (community.wave.seqera.io), which is firewalled in
        // some deployment environments (e.g. our AWS setup). staphb/bcftools:1.20 is already
        // used by every other bcftools-based process in this pipeline (BCFTOOLS_VIEW,
        // BCFTOOLS_FILTER, BCFTOOLS_NORM, SPLIT_MULTIALLELICS) -- this just brings ANNOTATE
        // in line with that, rather than introducing a new pinned version.
        container = 'staphb/bcftools:1.20'
        ext.args = { "-Oz -c INFO/slivar_comphet -x INFO/comphet_side,INFO/het_side,INFO/denovo_side --write-index=tbi" }
        ext.prefix = { "variants.${meta.id}.snv.vep.slivar" }
        publishDir = [
            path: { "${params.outdir}/slivar" },
            mode: params.publish_dir_mode,
            pattern: '*{vcf.gz,vcf.gz.tbi}'
        ]
    }
}
